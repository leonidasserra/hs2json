cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Leonidas Serra, Jose Nunes
maintainer:         leonidas.serra@discente.ufma.br
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    exposed-modules:
        SimpleJSON
        PutJSON
        Prettify
    hs-source-dirs:   src
    build-depends:    base >=4.14 && <5
    default-language: Haskell2010

executable hs2json
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5, hs2json
    default-language: Haskell2010
